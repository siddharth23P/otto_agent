    "in.org.npci.upiapp", "com.dreamplug.androidapp", "com.mobikwik_new",
    "com.freecharge.android", "in.amazon.mShop.android.shopping.paymentsdk",
    "com.paypal.android.p2pmobile", "com.venmo", "com.squareup.cash",
    "com.revolut.revolut", "com.wise", "com.coinbase.android", "com.binance.dev",
    "com.zerodha.kite3", "in.upstox.pro", "com.nextbillion.groww", "com.angelbroking.angelwealth",
    "com.sbi.lotusintouch", "com.snapwork.hdfc", "com.csam.icici.bank.imobile",
    "com.axis.mobile", "com.msf.kbank.mobile", "com.infrasofttech.indianbank",
    "com.chase.sig.android", "com.wf.wellsfargomobile", "com.infonow.bofa",
